# === CORE APP ENVIRONMENT ===
DATABASE_URL=""
DIRECT_URL=""
CRON_SECRET=""
ADMIN_PASSWORD=""
# Secreto usado para firmar las cookies de sesión del admin. OBLIGATORIO en producción:
# debe ser un valor aleatorio independiente de ADMIN_PASSWORD (ej: openssl rand -hex 32).
# Si se omite, se reutiliza ADMIN_PASSWORD como fallback (no recomendado).
SESSION_SECRET=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# URL pública de Supabase (usada por next.config.js para permitir las imágenes del storage)
NEXT_PUBLIC_SUPABASE_URL=""
RESEND_API_KEY=""

# === RATE LIMITING DISTRIBUIDO (opcional, recomendado en producción) ===
# Backend Redis compatible con la API REST de Upstash o Vercel KV. Si no se
# configura, el rate limit usa memoria local (no válido en serverless).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# === INTELIGENCIA ARTIFICIAL ===
# Tres claves de Gemini, preferiblemente de proyectos distintos: el plan gratuito
# da su cuota POR PROYECTO y POR MODELO (20 peticiones al día por modelo en los
# Flash), así que tres claves del mismo proyecto no multiplican nada.
GEMINI_API_KEY=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
# Opcional: fija el primer modelo de cada cadena sin tocar el código. Detrás
# queda el resto de la cadena como respaldo si se agota la cuota diaria.
# GEMINI_MODEL_QUALITY="gemini-3.8-flash"    # redactar, corregir y auditar el texto
# GEMINI_MODEL_LITE="gemini-3.1-flash-lite"  # traducción y análisis de imágenes
# Plazo máximo de una llamada a Gemini (ms). Los modelos con razonamiento del
# plan gratuito pueden tardar minutos; pasado el plazo se abandona el intento.
# GEMINI_PLAZO_MS="300000"

# === IMÁGENES ===
# Generación con IA: Cloudflare Workers AI (plan gratuito permanente de 10.000
# neurons/día, unas 170 imágenes). CLOUDFLARE_API_TOKEN necesita el permiso
# "Workers AI: Read". Sin estas dos variables, el pipeline simplemente se salta
# la generación y usa las fuentes anteriores de la cascada.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Fotografía de archivo con licencia comercial (clave gratuita e instantánea en
# pixabay.com/api/docs). Sin clave, se salta este paso.
PIXABAY_API_KEY=""
# HF_TOKEN ya no se usa: la capa gratuita de Hugging Face dejó de cubrir el
# proyecto (HTTP 402). Se ha sustituido por Cloudflare Workers AI.

# === TELEGRAM ===
# TELEGRAM_CHAT_ID es para tus pruebas privadas; TELEGRAM_CHANNEL_ID para el canal público.
# Si TELEGRAM_CHANNEL_ID está definido, se usará ese por defecto para publicar artículos.
# TELEGRAM_CHAT_ID es también el chat autorizado a aprobar borradores: solo desde
# ese chat funcionan los botones del mensaje de aprobación. En Vercel (que es
# donde vive el webhook) hacen falta TELEGRAM_TOKEN y TELEGRAM_CHAT_ID.
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_CHANNEL_ID=""
# Opcional: si Telegram te da un secret_token al registrar el webhook, ponlo aquí
# y en el setWebhook. Sin él, el webhook se apoya en el chat del dueño y en el
# token del borrador.
TELEGRAM_WEBHOOK_SECRET=""

# === REVISIÓN EDITORIAL ===
# URL base para construir el enlace privado del borrador.
SITE_URL="https://www.emedoteme.es"

# === BLUESKY ===
BLUESKY_HANDLE=""
BLUESKY_PASSWORD=""

# === BINANCE SQUARE ===
BINANCE_SQUARE_API_KEY=""
MAX_POST_CHARS=900

# === TWITTER/X (API v2) ===
#TWITTER_API_KEY="api-key"
#TWITTER_API_SECRET="api-secret"
#TWITTER_ACCESS_TOKEN="access-token"
#TWITTER_ACCESS_TOKEN_SECRET="access-token-secret"

# Opcional: variable general de prueba
DRY_RUN=false

# ---
# Todas las variables pueden ser comentadas (#) si no se usa el servicio.
# NO compartir ni commitear este archivo con claves productivas.
# Para producción, usar un gestor de secretos adecuado o sistema seguro.