// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Article {
  id          String   @id @default(uuid())
  title       String
  titleEn     String?
  slug        String   @unique
  summary     String?
  summaryEn   String?
  content     String
  contentEn   String?
  keyPoints   String[] @default([])
  keyPointsEn String[] @default([])
  impactLevel String?
  complexity  String?
  tickers     String[] @default([])
  glossary    Json?    // Array of { term: string, definition: string }
  glossaryEn  Json?
  faqs        Json?    // Array of { question: string, answer: string }
  faqsEn      Json?
  imageUrl    String?
  imageCaption String?
  sourceUrl   String?
  // === Revisión editorial (flujo de aprobación por Telegram) ===
  // reviewStatus: 'approved' (publicado o aprobado), 'pending' (borrador
  // esperando el sí/no de Emérito), 'rejected' (descartado), 'hermes_review'
  // (se ha pedido un diagnóstico a EmeDotHermes antes de decidir).
  reviewStatus String   @default("approved")
  reviewedAt   DateTime?
  reviewNote   String?
  // Registro del control de calidad del texto: afirmaciones sin respaldo
  // detectadas contra las fuentes y correcciones aplicadas. Es la prueba de
  // que el borrador pasó una revisión automática antes de la humana.
  textQa       String?
  // Token aleatorio del borrador: viaja en el enlace privado y en los botones
  // de Telegram, y es lo único que permite abrir un artículo no publicado.
  reviewToken  String?  @unique
  // Momento en que se anunció en las redes sociales (Binance, Telegram, Bluesky).
  // Null = aprobado pero todavía sin anunciar.
  announcedAt  DateTime?
  author      String   @default("EmeDotEme AI")
  published   Boolean  @default(false)
  isOriginal  Boolean  @default(false)
  articleTags Tag[]
  isPinned    Boolean  @default(false)
  priority    Int      @default(0)
  publishedAt DateTime?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt(sort: Desc)])
  @@index([reviewStatus, announcedAt])
  @@index([categoryId])
  @@index([isOriginal])
  @@index([publishedAt(sort: Desc)])
  @@index([isPinned, priority(sort: Desc), publishedAt(sort: Desc)])
  @@index([tickers], type: Gin)
}

model Subscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default("global") // We only need one record, or we can use keys
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
